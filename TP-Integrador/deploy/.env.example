# Copiar a deploy/.env (ese archivo NO se sube al repositorio) y completar.
# Sin valores acá: todo lo que sea secreto va sólo en deploy/.env.

# Puerto publicado en el HOST para probar desde la LAN (el 8765 del host ya
# está ocupado en el NAS). Dentro del contenedor el servidor sigue en 8765.
FDC_HOST_PORT=18765

# Password de la vista completa del panel del servidor (/status/full).
# Vacío: queda sólo la vista pública (/status).
FDC_PANEL_PASSWORD=

# Red bridge del cloudflared que YA corre en el NAS (el túnel de
# timecore.com.ar). El servidor se conecta ahí con el nombre fdc-server.
FDC_TUNNEL_NETWORK=timecore-prod_default

# Sólo para el perfil "tunel" (un cloudflared propio para este servidor).
# Normalmente NO hace falta: se suma el hostname al túnel existente.
TUNNEL_TOKEN=

    <script type="application/javascript">

    // --- Futbol De Cabeza: loading screen --------------------------------
    window.fdcSplash = (function () {
        const splash = document.getElementById("fdc-splash")
        const stageEl = document.getElementById("fdc-stage")
        const fill = document.getElementById("fdc-fill")
        const msg = document.getElementById("fdc-msg")
        let pct = 0, phase = "python", poll = null, hideTimer = null

        function fit() {
            const k = Math.min(window.innerWidth / 1280, window.innerHeight / 720)
            stageEl.style.transform = "scale(" + k + ") translate(-50%, -50%)"
        }
        function setPct(p) {
            pct = Math.max(pct, Math.min(100, p))
            fill.style.width = "calc((100% - 12px) * " + (pct / 100) + ")"
        }
        function setMsg(key) { msg.src = "txt_" + key + ".png" }
        function start() {
            if (window.MM) { MM.UME = 1 }          // the click or the key enables audio
            const c = document.getElementById("canvas")
            if (c) c.focus()
            splash.classList.remove("ready")
            setMsg("players")
        }

        window.addEventListener("resize", fit)
        fit()
        // while Python (WebAssembly) downloads, the pygbag progress is used
        poll = setInterval(function () {
            const p = document.getElementById("progress")
            if (phase === "python" && p && p.max) setPct(Math.min(60, 60 * p.value / p.max))
        }, 120)

        document.getElementById("fdc-play").addEventListener("click", start)
        window.addEventListener("keydown", function (e) {
            if (splash.classList.contains("ready")) start()
        })

        return {
            stage: function (p, key) { phase = key; setPct(p); setMsg(key) },
            ready: function () {
                phase = "ready"; setPct(100); setMsg("ready")
                if (window.MM && MM.UME) { start(); return }     // the browser already allowed audio
                splash.classList.add("ready")
            },
            started: function () {
                // safety net: if the game does not tell, it is hidden anyway
                if (!hideTimer) hideTimer = setTimeout(window.fdcSplash.done, 20000)
            },
            done: function () {
                clearInterval(poll)
                splash.classList.add("hidden")
                setTimeout(function () { splash.style.display = "none" }, 600)
            }
        }
    })()

